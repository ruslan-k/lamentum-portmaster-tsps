[ -n "${UA_PAD_NAME+x}" ] || export UA_PAD_NAME="Xbox Wireless Controller"
# Unity 2019.4 has no AGC gamepad state: the pad axes never reach the game, its buttons do.
# So the d-pad presses the keyboard keys the game already binds (arrows/WASD move, Enter confirms,
# E acts, Space dodges, I opens the inventory, 1/2/3 are the shortcuts, Esc is back).
export UA_KEYMAP="up:up,down:down,left:left,right:right,a:return,b:3,x:1,y:2,start:escape,select:i,l1:space,r1:e"
