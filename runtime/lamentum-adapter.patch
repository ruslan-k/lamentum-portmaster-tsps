+#ifndef LC2_PROBE_GUARD_H
+#define LC2_PROBE_GUARD_H
+#include <stdint.h>
+/* c3 accesses through element 38 require at least 156 bytes. The captured
+ * shader enables its volume path iff the F32 flag at byte 32 equals +1.0. */
+static inline int lc2_probe_guard(uint64_t bytes,uint32_t word) {
+    if(bytes<156)return -1;
+    return word!=UINT32_C(0x3f800000);
+}
+#endif
