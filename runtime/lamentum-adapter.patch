diff --git a/native/lc2_alloc_ledger.h b/native/lc2_alloc_ledger.h
new file mode 100644
index 0000000..c62fd85
--- /dev/null
+++ b/native/lc2_alloc_ledger.h
@@ -0,0 +1,61 @@
+/* LC2_ALLOC_LEDGER=1 (owner roadmap 48 / M1): per-allocation receipts for the
+ * storage classes the adapter creates outside the texture path, so a CMA drop can
+ * be tied to a concrete call instead of an inference.
+ *
+ * Bounded (first 64 lines), opt-in by value, host-only bookkeeping: no GL call is
+ * added or removed and no allocation is changed. Values are format-defined sizes;
+ * the driver's physical commitment stays `unknown`.
+ */
+#ifndef LC2_ALLOC_LEDGER_H
+#define LC2_ALLOC_LEDGER_H
+static struct {
+    unsigned configured, enabled, seq, lines, overflow;
+    uint64_t rb_bytes, buf_bytes, surface_bytes;
+    unsigned rb_count, buf_count, surface_count;
+} lc2_alloc_ledger;
+
+static void lc2_alloc_retired(const char *cls, uint64_t bytes, unsigned a, unsigned b, unsigned c);
+
+static void lc2_alloc_note(const char *cls, uint64_t bytes, unsigned a, unsigned b, unsigned c) {
+    if(!lc2_alloc_ledger.configured) {
+        const char *option=getenv("LC2_ALLOC_LEDGER");
+        lc2_alloc_ledger.enabled=option && !strcmp(option,"1");
+        lc2_alloc_ledger.configured=1;
+        if(lc2_alloc_ledger.enabled)
+            printf("LC2_ALLOC_LEDGER enabled=1 bounded-lines=64 classes=renderbuffer,buffer,egl-surface"
+                   " sizes=format-defined physical=unknown behaviour=unchanged\n");
+    }
+    if(!lc2_alloc_ledger.enabled)return;
+    if(!strcmp(cls,"renderbuffer")) {lc2_alloc_ledger.rb_bytes+=bytes;lc2_alloc_ledger.rb_count++;}
+    else if(!strcmp(cls,"buffer")) {lc2_alloc_ledger.buf_bytes+=bytes;lc2_alloc_ledger.buf_count++;}
+    else {lc2_alloc_ledger.surface_bytes+=bytes;lc2_alloc_ledger.surface_count++;}
+    lc2_alloc_ledger.seq++;
+    if(lc2_alloc_ledger.lines>=64) {lc2_alloc_ledger.overflow=1;return;}
+    lc2_alloc_ledger.lines++;
+    printf("LC2_ALLOC seq=%u class=%s bytes=%llu a=%u b=%u c=0x%x"
+           " rb-total-bytes=%llu rb-count=%u buf-total-bytes=%llu buf-count=%u"
+           " surface-total-bytes=%llu surface-count=%u serial=none physical=unknown\n",
+           lc2_alloc_ledger.seq,cls,(unsigned long long)bytes,a,b,c,
+           (unsigned long long)lc2_alloc_ledger.rb_bytes,lc2_alloc_ledger.rb_count,
+           (unsigned long long)lc2_alloc_ledger.buf_bytes,lc2_alloc_ledger.buf_count,
+           (unsigned long long)lc2_alloc_ledger.surface_bytes,lc2_alloc_ledger.surface_count);
+}
+/* Retire receipt: the same class accounting, so allocate/free can be balanced.
+ * Bounded like the allocate path; a free without a prior allocate is flagged. */
+static void lc2_alloc_retired(const char *cls, uint64_t bytes, unsigned a, unsigned b, unsigned c) {
+    if(!lc2_alloc_ledger.enabled)return;
+    if(!strcmp(cls,"renderbuffer")) {if(lc2_alloc_ledger.rb_bytes>=bytes)lc2_alloc_ledger.rb_bytes-=bytes;}
+    else if(!strcmp(cls,"buffer")) {if(lc2_alloc_ledger.buf_bytes>=bytes)lc2_alloc_ledger.buf_bytes-=bytes;}
+    else {if(lc2_alloc_ledger.surface_bytes>=bytes)lc2_alloc_ledger.surface_bytes-=bytes;}
+    lc2_alloc_ledger.seq++;
+    if(lc2_alloc_ledger.lines>=64) {lc2_alloc_ledger.overflow=1;return;}
+    lc2_alloc_ledger.lines++;
+    printf("LC2_ALLOC_RETIRE seq=%u class=%s bytes=%llu a=%u b=%u c=0x%x"
+           " rb-total-bytes=%llu buf-total-bytes=%llu surface-total-bytes=%llu"
+           " balance=%s physical=unknown\n",
+           lc2_alloc_ledger.seq,cls,(unsigned long long)bytes,a,b,c,
+           (unsigned long long)lc2_alloc_ledger.rb_bytes,
+           (unsigned long long)lc2_alloc_ledger.buf_bytes,
+           (unsigned long long)lc2_alloc_ledger.surface_bytes,"tracked");
+}
+#endif
diff --git a/native/lc2_bc_owner_receipt.h b/native/lc2_bc_owner_receipt.h
new file mode 100644
index 0000000..ff23bbb
--- /dev/null
+++ b/native/lc2_bc_owner_receipt.h
@@ -0,0 +1,81 @@
+/* B1 pre-refusal receipt for a deferred-BC first-use owner.
+ *
+ * Emitted BEFORE the budget charge, because a refusal terminates the process and
+ * the descriptor is exactly what the refusal destroys. It is opt-in
+ * (LC2_BC_OWNER_RECEIPT=1), bounded (8 owners per run) and reads only host-side
+ * adapter metadata: no guest memory is touched while the process is under
+ * memory pressure, and no content hash is computed here.
+ *
+ * Facts and hypotheses are kept apart on purpose:
+ *   immutable=unproven, source-hash=not-read, gl-allocation=not-attempted,
+ *   driver-physical=unknown, present-serial/phase=unavailable in this build.
+ * A field that was not measured says so instead of carrying a zero.
+ */
+#ifndef LC2_BC_OWNER_RECEIPT_H
+#define LC2_BC_OWNER_RECEIPT_H
+/* Emission and budget locking live outside the tested block so the receipt body
+ * itself can be compiled against stubs (tools/test_bc_owner_receipt.py). */
+static void lc2_bc_receipt_emit(const char *text,uint64_t owner) {
+    printf("LC2_BC_OWNER_RECEIPT owner-id=%llu %s\n",(unsigned long long)owner,text);
+    fflush(stdout);
+}
+static void t2_texture_budget_lock(void) {pthread_mutex_lock(&t2_texture_budget_mutex);}
+static void t2_texture_budget_unlock(void) {pthread_mutex_unlock(&t2_texture_budget_mutex);}
+/* LC2_BC_OWNER_RECEIPT_BEGIN */
+static struct {uint64_t seen[8];unsigned count,overflow,configured,enabled;} lc2_bc_receipts;
+static void lc2_bc_owner_receipt(const struct nvn_texture *view,const struct nvn_texture *t,
+        unsigned bc,unsigned type,unsigned bpp,uint64_t prospective) {
+    if(!lc2_bc_receipts.configured) {
+        const char *option=getenv("LC2_BC_OWNER_RECEIPT");
+        lc2_bc_receipts.enabled=option && !strcmp(option,"1");
+        lc2_bc_receipts.configured=1;
+    }
+    if(!lc2_bc_receipts.enabled)return;
+    for(unsigned i=0;i<lc2_bc_receipts.count;i++)if(lc2_bc_receipts.seen[i]==t->id)return;
+    if(lc2_bc_receipts.count==8) {lc2_bc_receipts.overflow=1;return;}
+    lc2_bc_receipts.seen[lc2_bc_receipts.count++]=t->id;
+    const char *run=getenv("LAMENTUM_RUN_UUID");
+    t2_texture_budget_lock();
+    uint64_t charged=t->t2_budget_bytes,live=t2_texture_budget.live_bytes,
+             peak=t2_texture_budget.peak_bytes,count=t2_texture_budget.count;
+    t2_texture_budget_unlock();
+    char text[1024];
+    int n=snprintf(text,sizeof text,
+        "mode=pre-refusal run-uuid=%s phase=unavailable present-serial=unavailable"
+        " view-id=%llu owner-object=0x%llx view-object=0x%llx alias=%u"
+        " levels=%u width=%u height=%u depth=%u target=%u format=0x%x srgb=%u"
+        " swizzle=%u,%u,%u,%u flags=0x%x samples=%u block-bytes=%u upload-type=0x%x output-bpp=%u"
+        " prospective-charge-bytes=%llu charged-owner-bytes=%llu budget-live-bytes=%llu"
+        " budget-peak-bytes=%llu budget-charges=%llu"
+        " guest-storage-bytes=%llu pool-object=0x%llx pool-address=0x%llx pool-bytes=%llu"
+        " pool-generation=%llu pool-flags=0x%x pool-offset=%llu snapshot-generation=%u"
+        " gl-name=%u depth-buffer=%u pending=%u draws=%u target-seen=%u references=%u caller=0x%llx"
+        " storage-generation=untracked immutable=unproven source-hash=not-read"
+        " gl-allocation=not-attempted driver-physical=unknown guest-memory-read=none",
+        run?run:"unavailable",(unsigned long long)view->id,
+        (unsigned long long)t->object,(unsigned long long)view->object,(unsigned)(view!=t),
+        t->b.levels,t->b.width,t->b.height,t->b.depth,t->b.target,t->b.format,bc?1U:0U,
+        t->b.swizzle[0],t->b.swizzle[1],t->b.swizzle[2],t->b.swizzle[3],t->b.flags,t->b.samples,bc,type,bpp,
+        (unsigned long long)prospective,(unsigned long long)charged,(unsigned long long)live,
+        (unsigned long long)peak,(unsigned long long)count,
+        (unsigned long long)t->size,(unsigned long long)(t->pool?t->pool->object:0),
+        (unsigned long long)(t->pool?t->pool->address:0),(unsigned long long)(t->pool?t->pool->size:0),
+        (unsigned long long)(t->pool?t->pool->generation:0),t->pool?t->pool->flags:0U,
+        (unsigned long long)t->b.offset,(unsigned)t->lc2_bc_pending,t->name,t->depth_buffer,
+        t->lc2_bc_pending,t->draws,t->composition_target_seen,t->references,
+        (unsigned long long)nvn_caller);
+    if(n<0) {lc2_bc_receipts.overflow=1;return;}
+    unsigned width=t->b.width,height=t->b.height;
+    for(unsigned level=0;level<t->b.levels && level<14 && n>0 && (size_t)n<sizeof text;level++) {
+        uint64_t bytes=(uint64_t)width*height*bpp;
+        int added=snprintf(text+n,sizeof text-(size_t)n," level=%u width=%u height=%u decoded-bytes=%llu",
+                           level,width,height,(unsigned long long)bytes);
+        if(added<0 || (size_t)added>=sizeof text-(size_t)n)break;
+        n+=added;
+        if(width>1)width>>=1;
+        if(height>1)height>>=1;
+    }
+    lc2_bc_receipt_emit(text,t->id);
+}
+/* LC2_BC_OWNER_RECEIPT_END */
+#endif
diff --git a/native/lc2_cbuf_units.h b/native/lc2_cbuf_units.h
new file mode 100644
index 0000000..6f3885e
--- /dev/null
+++ b/native/lc2_cbuf_units.h
@@ -0,0 +1,10 @@
+/* Constant-buffer emulation occupies distinct units below high helper units,
+ * above all ordinary textures/palette helpers. Never wrap an exhausted range. */
+#ifndef LC2_CBUF_UNITS_H
+#define LC2_CBUF_UNITS_H
+static inline int lc2_cbuf_unit(unsigned limit,unsigned bottom,unsigned top,unsigned ordinal) {
+    if(top>=limit || ordinal>=limit-top)return -1;
+    unsigned unit=limit-top-1-ordinal;
+    return unit>=bottom?(int)unit:-1;
+}
+#endif
diff --git a/native/lc2_cost.h b/native/lc2_cost.h
new file mode 100644
index 0000000..b6d1e24
--- /dev/null
+++ b/native/lc2_cost.h
@@ -0,0 +1,262 @@
+/* C0 diagnostic only. Bounded all-thread, cumulative handler counters.
+ * Each completed measured call has independent thread-CPU and MONOTONIC_RAW clocks.
+ * Exclusive intervals subtract direct children's inclusive intervals (not their exclusive
+ * intervals). Raw wall values are NEVER clamped to CPU values. Measurement overhead is
+ * included and must be qualified by a same-phase OFF/ON arm before a performance claim.
+ *
+ * Registration reads this thread's /proc identity once, BEFORE starting its first timer.
+ * There is no allocation, logging or mutex in a measured interval. Registry fields are
+ * atomic; a bounded seqlock snapshot either produces a consistent row or says incomplete.
+ * Retired threads retain their rows: stop-time reporting includes sub-4096-call tails.
+ * SIGKILL cannot flush anything; absent/incomplete reports must not mean zero cost.
+ */
+#ifndef LC2_COST_H
+#define LC2_COST_H
+#include <stdint.h>
+#include <stddef.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+#include <fcntl.h>
+#include <errno.h>
+#include <sys/syscall.h>
+
+enum {LC2_COST_WAIT,LC2_COST_RELEASE,LC2_COST_AUDOUT7,LC2_COST_AUDOUT8,
+      LC2_COST_BC_DECODE,LC2_COST_CLASSES};
+static const char *const lc2_cost_names[LC2_COST_CLASSES]={
+    "svc0x1a-wait","svc0x1b-release","audout-cmd7","audout-cmd8","bc-decode"};
+#ifndef LC2_COST_THREADS
+#define LC2_COST_THREADS 128
+#endif
+#ifndef LC2_COST_DEPTH
+#define LC2_COST_DEPTH 16
+#endif
+#ifndef LC2_COST_CLOCK
+#define LC2_COST_CLOCK clock_gettime
+#endif
+struct lc2_cost_values {
+    uint64_t entered,completed,valid,invalid,cpu_inclusive_ns,cpu_exclusive_ns;
+    uint64_t wall_inclusive_ns,wall_exclusive_ns,max_cpu_ns,max_wall_ns,wall_lt_cpu;
+};
+struct lc2_cost_row {uint64_t seq;struct lc2_cost_values v;};
+struct lc2_cost_slot {
+    uint64_t published,tid,starttime,nesting_errors;
+    struct lc2_cost_row rows[LC2_COST_CLASSES];
+};
+struct lc2_cost_frame {
+    uint64_t token,cpu,wall,child_cpu,child_wall;unsigned bucket,valid;
+};
+static struct lc2_cost_slot lc2_cost_slots[LC2_COST_THREADS];
+static uint64_t lc2_cost_next,lc2_cost_overflow,lc2_cost_identity_failures,lc2_cost_report_id;
+static int lc2_cost_mode=-1,lc2_cost_reporting;
+static _Thread_local struct {
+    int slot;unsigned initialized,depth;uint64_t next_token;
+    struct lc2_cost_frame frames[LC2_COST_DEPTH];
+} lc2_cost_state;
+#define LC2_COST_LOAD(p) __atomic_load_n((p),__ATOMIC_ACQUIRE)
+#define LC2_COST_STORE(p,v) __atomic_store_n((p),(v),__ATOMIC_RELEASE)
+
+/* These small writers are also used on stop(), including signal/fault paths. */
+struct lc2_cost_line {char data[2048];size_t used;};
+static inline void lc2_cost_text(struct lc2_cost_line *b,const char *s) {
+    while(*s && b->used<sizeof(b->data))b->data[b->used++]=*s++;
+}
+static inline void lc2_cost_uint(struct lc2_cost_line *b,uint64_t n) {
+    char reversed[24];unsigned count=0;
+    do {reversed[count++]=(char)('0'+n%10);n/=10;}while(n);
+    while(count && b->used<sizeof(b->data))b->data[b->used++]=reversed[--count];
+}
+static inline void lc2_cost_field(struct lc2_cost_line *b,const char *key,uint64_t value) {
+    lc2_cost_text(b," ");lc2_cost_text(b,key);lc2_cost_text(b,"=");lc2_cost_uint(b,value);
+}
+static inline void lc2_cost_write(int fd,struct lc2_cost_line *b) {
+    lc2_cost_text(b,"\n");size_t at=0;unsigned interrupted=0;
+    while(at<b->used) {
+        ssize_t n=write(fd,b->data+at,b->used-at);
+        if(n>0)at+=(size_t)n;
+        else if(n<0 && errno==EINTR && interrupted++<8)continue;
+        else break;
+    }
+}
+static inline int lc2_cost_enabled(void) {
+    int mode=__atomic_load_n(&lc2_cost_mode,__ATOMIC_ACQUIRE);
+    if(mode<0) {
+        const char *s=getenv("LC2_SVC_COST");mode=s&&!strcmp(s,"1");
+        __atomic_store_n(&lc2_cost_mode,mode,__ATOMIC_RELEASE);
+    }
+    return mode;
+}
+static inline int lc2_cost_read_clock(clockid_t clock,uint64_t *out) {
+    struct timespec t;
+    if(LC2_COST_CLOCK(clock,&t) || t.tv_sec<0 || t.tv_nsec<0 || t.tv_nsec>=1000000000L)return 0;
+    *out=(uint64_t)t.tv_sec*UINT64_C(1000000000)+(uint64_t)t.tv_nsec;return 1;
+}
+/* Field 22 is token 19 after the final comm parenthesis, not after the first one. */
+static inline int lc2_cost_parse_start(const char *s,uint64_t *value) {
+    const char *last=NULL;
+    for(const char *p=s;*p;p++)if(*p==')')last=p;
+    if(!last)return 0;
+    const char *p=last+1;
+    for(unsigned field=0;field<19;field++) {
+        while(*p==' ' || *p=='\t')p++;
+        if(!*p)return 0;
+        while(*p && *p!=' ' && *p!='\t' && *p!='\n')p++;
+    }
+    while(*p==' ' || *p=='\t')p++;
+    if(*p<'0' || *p>'9')return 0;
+    uint64_t n=0;
+    while(*p>='0' && *p<='9') {
+        unsigned digit=(unsigned)(*p++-'0');
+        if(n>(UINT64_MAX-digit)/10)return 0;
+        n=n*10+digit;
+    }
+    if(*p && *p!=' ' && *p!='\n' && *p!='\t')return 0;
+    *value=n;return 1;
+}
+static inline struct lc2_cost_slot *lc2_cost_register(void) {
+    if(lc2_cost_state.initialized)
+        return lc2_cost_state.slot<0?NULL:&lc2_cost_slots[lc2_cost_state.slot];
+    lc2_cost_state.initialized=1;lc2_cost_state.slot=-1;
+    long tid=syscall(SYS_gettid);uint64_t start=0;
+    struct lc2_cost_line path={.used=0};lc2_cost_text(&path,"/proc/self/task/");
+    lc2_cost_uint(&path,(uint64_t)tid);lc2_cost_text(&path,"/stat");path.data[path.used]=0;
+    char stat[1024];ssize_t n=-1;int saved_errno=errno;
+    int fd=open(path.data,O_RDONLY|O_CLOEXEC);
+    if(fd>=0){n=read(fd,stat,sizeof(stat)-1);close(fd);}
+    errno=saved_errno;
+    if(n<=0 || (stat[n]=0,!lc2_cost_parse_start(stat,&start))) {
+        __atomic_fetch_add(&lc2_cost_identity_failures,1,__ATOMIC_RELAXED);return NULL;
+    }
+    uint64_t index=__atomic_fetch_add(&lc2_cost_next,1,__ATOMIC_RELAXED);
+    if(index>=LC2_COST_THREADS) {
+        __atomic_fetch_add(&lc2_cost_overflow,1,__ATOMIC_RELAXED);return NULL;
+    }
+    struct lc2_cost_slot *slot=&lc2_cost_slots[index];
+    slot->tid=(uint64_t)tid;slot->starttime=start;
+    lc2_cost_state.slot=(int)index;LC2_COST_STORE(&slot->published,1);return slot;
+}
+static inline void lc2_cost_row_begin(struct lc2_cost_row *r) {
+    __atomic_add_fetch(&r->seq,1,__ATOMIC_ACQ_REL);
+}
+static inline void lc2_cost_row_end(struct lc2_cost_row *r) {
+    __atomic_add_fetch(&r->seq,1,__ATOMIC_RELEASE);
+}
+static inline void lc2_cost_increment(uint64_t *p) {__atomic_fetch_add(p,1,__ATOMIC_RELAXED);}
+static inline void lc2_cost_add(uint64_t *p,uint64_t n) {__atomic_fetch_add(p,n,__ATOMIC_RELAXED);}
+static inline uint64_t lc2_cost_enter(unsigned bucket) {
+    int saved_errno=errno;
+    if(bucket>=LC2_COST_CLASSES || !lc2_cost_enabled())return 0;
+    struct lc2_cost_slot *slot=lc2_cost_register();if(!slot){errno=saved_errno;return 0;}
+    unsigned depth=lc2_cost_state.depth;
+    if(depth==LC2_COST_DEPTH) {
+        lc2_cost_increment(&slot->nesting_errors);
+        for(unsigned i=0;i<depth;i++)lc2_cost_state.frames[i].valid=0;
+        errno=saved_errno;return 0;
+    }
+    struct lc2_cost_frame *f=&lc2_cost_state.frames[depth];
+    *f=(struct lc2_cost_frame){.bucket=bucket,.valid=1};
+    f->token=++lc2_cost_state.next_token;
+    if(!f->token)f->token=++lc2_cost_state.next_token;
+    f->valid=lc2_cost_read_clock(CLOCK_MONOTONIC_RAW,&f->wall);
+    f->valid&=lc2_cost_read_clock(CLOCK_THREAD_CPUTIME_ID,&f->cpu);
+    lc2_cost_state.depth++;
+    struct lc2_cost_row *row=&slot->rows[bucket];lc2_cost_row_begin(row);
+    lc2_cost_increment(&row->v.entered);lc2_cost_row_end(row);
+    errno=saved_errno;
+    return f->token;
+}
+static inline void lc2_cost_leave(unsigned bucket,uint64_t token) {
+    int saved_errno=errno;
+    if(!token || lc2_cost_state.slot<0 || !lc2_cost_state.depth)return;
+    struct lc2_cost_slot *slot=&lc2_cost_slots[lc2_cost_state.slot];
+    struct lc2_cost_frame *f=&lc2_cost_state.frames[lc2_cost_state.depth-1];
+    if(f->token!=token || f->bucket!=bucket) {
+        lc2_cost_increment(&slot->nesting_errors);
+        for(unsigned i=0;i<lc2_cost_state.depth;i++)lc2_cost_state.frames[i].valid=0;
+        return;
+    }
+    uint64_t cpu_end=0,wall_end=0;
+    unsigned valid=lc2_cost_read_clock(CLOCK_THREAD_CPUTIME_ID,&cpu_end);
+    valid&=lc2_cost_read_clock(CLOCK_MONOTONIC_RAW,&wall_end);
+    valid&=f->valid && cpu_end>=f->cpu && wall_end>=f->wall;
+    uint64_t cpu=valid?cpu_end-f->cpu:0,wall=valid?wall_end-f->wall:0;
+    valid&=cpu>=f->child_cpu && wall>=f->child_wall;
+    lc2_cost_state.depth--;
+    if(lc2_cost_state.depth) {
+        struct lc2_cost_frame *parent=&lc2_cost_state.frames[lc2_cost_state.depth-1];
+        if(valid){parent->child_cpu+=cpu;parent->child_wall+=wall;}else parent->valid=0;
+    }
+    struct lc2_cost_row *row=&slot->rows[bucket];lc2_cost_row_begin(row);
+    struct lc2_cost_values *v=&row->v;lc2_cost_increment(&v->completed);
+    if(valid) {
+        lc2_cost_increment(&v->valid);
+        lc2_cost_add(&v->cpu_inclusive_ns,cpu);lc2_cost_add(&v->cpu_exclusive_ns,cpu-f->child_cpu);
+        lc2_cost_add(&v->wall_inclusive_ns,wall);lc2_cost_add(&v->wall_exclusive_ns,wall-f->child_wall);
+        if(cpu>LC2_COST_LOAD(&v->max_cpu_ns))LC2_COST_STORE(&v->max_cpu_ns,cpu);
+        if(wall>LC2_COST_LOAD(&v->max_wall_ns))LC2_COST_STORE(&v->max_wall_ns,wall);
+        if(wall<cpu)lc2_cost_increment(&v->wall_lt_cpu);
+    } else lc2_cost_increment(&v->invalid);
+    lc2_cost_row_end(row);
+    errno=saved_errno;
+}
+static inline int lc2_cost_snapshot(struct lc2_cost_row *row,struct lc2_cost_values *v) {
+    for(unsigned retry=0;retry<3;retry++) {
+        uint64_t seq=LC2_COST_LOAD(&row->seq);if(seq&1)continue;
+#define LC2_COST_COPY(name) v->name=LC2_COST_LOAD(&row->v.name)
+        LC2_COST_COPY(entered);LC2_COST_COPY(completed);LC2_COST_COPY(valid);LC2_COST_COPY(invalid);
+        LC2_COST_COPY(cpu_inclusive_ns);LC2_COST_COPY(cpu_exclusive_ns);
+        LC2_COST_COPY(wall_inclusive_ns);LC2_COST_COPY(wall_exclusive_ns);
+        LC2_COST_COPY(max_cpu_ns);LC2_COST_COPY(max_wall_ns);LC2_COST_COPY(wall_lt_cpu);
+#undef LC2_COST_COPY
+        __atomic_thread_fence(__ATOMIC_ACQUIRE);
+        if(seq==LC2_COST_LOAD(&row->seq))return 1;
+    }
+    return 0;
+}
+/* Explicit cumulative report. Call before _exit; do not depend on stdio/atexit/TLS destructors. */
+static inline void lc2_cost_report_fd(int fd) {
+    /* Never parse the environment in a fault/stop handler. No entered call means
+       no report, which the parser treats as missing evidence rather than zero. */
+    if(__atomic_load_n(&lc2_cost_mode,__ATOMIC_ACQUIRE)!=1 ||
+       __atomic_exchange_n(&lc2_cost_reporting,1,__ATOMIC_ACQUIRE))return;
+    int saved_errno=errno;uint64_t report=__atomic_add_fetch(&lc2_cost_report_id,1,__ATOMIC_RELAXED);
+    uint64_t count=LC2_COST_LOAD(&lc2_cost_next),incomplete=0,rows=0;
+    struct lc2_cost_line b={.used=0};lc2_cost_text(&b,"LC2_COST_V2_BEGIN");
+    lc2_cost_field(&b,"report",report);lc2_cost_field(&b,"slots",count);
+    lc2_cost_field(&b,"overflow",LC2_COST_LOAD(&lc2_cost_overflow));
+    lc2_cost_field(&b,"identity_failures",LC2_COST_LOAD(&lc2_cost_identity_failures));
+    lc2_cost_text(&b," cpu_clock=THREAD_CPUTIME_ID wall_clock=MONOTONIC_RAW cumulative=1 diagnostic=1");
+    lc2_cost_write(fd,&b);
+    for(uint64_t i=0;i<count && i<LC2_COST_THREADS;i++) {
+        struct lc2_cost_slot *slot=&lc2_cost_slots[i];
+        if(!LC2_COST_LOAD(&slot->published)){incomplete++;continue;}
+        for(unsigned cls=0;cls<LC2_COST_CLASSES;cls++) {
+            struct lc2_cost_values v;
+            if(!lc2_cost_snapshot(&slot->rows[cls],&v)){incomplete++;continue;}
+            if(!v.entered)continue;
+            b=(struct lc2_cost_line){.used=0};lc2_cost_text(&b,"LC2_COST_V2 class=");
+            lc2_cost_text(&b,lc2_cost_names[cls]);lc2_cost_field(&b,"report",report);
+            lc2_cost_field(&b,"tid",slot->tid);lc2_cost_field(&b,"tid_starttime",slot->starttime);
+            lc2_cost_field(&b,"nesting_errors",LC2_COST_LOAD(&slot->nesting_errors));
+#define LC2_COST_EMIT(name) lc2_cost_field(&b,#name,v.name)
+            LC2_COST_EMIT(entered);LC2_COST_EMIT(completed);LC2_COST_EMIT(valid);LC2_COST_EMIT(invalid);
+            LC2_COST_EMIT(cpu_inclusive_ns);LC2_COST_EMIT(cpu_exclusive_ns);
+            LC2_COST_EMIT(wall_inclusive_ns);LC2_COST_EMIT(wall_exclusive_ns);
+            LC2_COST_EMIT(max_cpu_ns);LC2_COST_EMIT(max_wall_ns);LC2_COST_EMIT(wall_lt_cpu);
+#undef LC2_COST_EMIT
+            lc2_cost_text(&b," scope=measured-handlers-only raw_wall=1");lc2_cost_write(fd,&b);rows++;
+        }
+    }
+    b=(struct lc2_cost_line){.used=0};lc2_cost_text(&b,"LC2_COST_V2_END");
+    lc2_cost_field(&b,"report",report);lc2_cost_field(&b,"rows",rows);
+    lc2_cost_field(&b,"incomplete_snapshots",incomplete);lc2_cost_write(fd,&b);
+    errno=saved_errno;__atomic_store_n(&lc2_cost_reporting,0,__ATOMIC_RELEASE);
+}
+static inline int lc2_cost_ipc_class(unsigned is_audout,unsigned command) {
+    if(!is_audout)return -1;
+    if(command==7)return LC2_COST_AUDOUT7;
+    if(command==8)return LC2_COST_AUDOUT8;
+    return -1;
+}
+#endif
diff --git a/native/lc2_fileback.h b/native/lc2_fileback.h
new file mode 100644
index 0000000..099c7d0
--- /dev/null
+++ b/native/lc2_fileback.h
@@ -0,0 +1,54 @@
+/* Lossless, private file backing for immutable-at-publication CPU ranges.
+ * Caller owns an existing RW, private mapping and excludes concurrent writers.
+ * Full pages only; writes remain private COW. File must stay immutable afterward.
+ * The caller must not use the anonymous-only guest compressor on these pages. */
+#ifndef LC2_FILEBACK_H
+#define LC2_FILEBACK_H
+#include <stdint.h>
+#include <stddef.h>
+#include <unistd.h>
+#include <sys/mman.h>
+#include <errno.h>
+#include <string.h>
+/* Snapshots are serialized by the caller. Publish permanent exclusions for
+ * anonymous-only compactors, even after a texture pool has been finalized. */
+#define LC2_FILEBACK_MAX_RANGES 4096
+static struct {uintptr_t start,end;} lc2_fileback_ranges[LC2_FILEBACK_MAX_RANGES];
+static unsigned lc2_fileback_range_count;
+static inline unsigned lc2_fileback_overlaps(uint64_t address,uint64_t size) {
+    unsigned count=__atomic_load_n(&lc2_fileback_range_count,__ATOMIC_ACQUIRE);
+    for(unsigned i=0;i<count;i++)if(address<lc2_fileback_ranges[i].end && lc2_fileback_ranges[i].start<address+size)return 1;
+    return 0;
+}
+static ssize_t lc2_fileback_snapshot(int fd,uint64_t *cursor,void *address,size_t size,uint64_t cap) {
+    uintptr_t begin=(uintptr_t)address;
+    if(!cursor || begin>UINTPTR_MAX-size || begin>UINTPTR_MAX-4095 || *cursor%4096){errno=EINVAL;return -1;}
+    uintptr_t first=(begin+4095)&~(uintptr_t)4095,end=(begin+size)&~(uintptr_t)4095;
+    size_t total=0;
+    while(first<end && *cursor<cap) {
+        unsigned slot=__atomic_load_n(&lc2_fileback_range_count,__ATOMIC_RELAXED);
+        if(slot>=LC2_FILEBACK_MAX_RANGES){errno=ENOSPC;return -1;}
+        size_t bytes=end-first;if(bytes>(1U<<20))bytes=1U<<20;
+        if(bytes>cap-*cursor)bytes=(size_t)(cap-*cursor)&~(size_t)4095;
+        if(!bytes)break;
+        size_t done=0;
+        while(done<bytes) {
+            ssize_t n=pwrite(fd,(void *)(first+done),bytes-done,(off_t)(*cursor+done));
+            if(n<0 && errno==EINTR)continue;
+            if(n<=0)return -1;
+            done+=(size_t)n;
+        }
+        if(fdatasync(fd))return -1;
+        void *probe=mmap(NULL,bytes,PROT_READ|PROT_WRITE,MAP_PRIVATE,fd,(off_t)*cursor);
+        if(probe==MAP_FAILED)return -1;
+        if(memcmp(probe,(void *)first,bytes)){munmap(probe,bytes);errno=EBUSY;return -1;}
+        void *mapped=mmap((void *)first,bytes,PROT_READ|PROT_WRITE,MAP_PRIVATE|MAP_FIXED,fd,(off_t)*cursor);
+        int error=errno;munmap(probe,bytes);
+        if(mapped==MAP_FAILED){errno=error;return -1;}
+        lc2_fileback_ranges[slot].start=first;lc2_fileback_ranges[slot].end=first+bytes;
+        __atomic_store_n(&lc2_fileback_range_count,slot+1,__ATOMIC_RELEASE);
+        *cursor+=bytes;first+=bytes;total+=bytes;
+    }
+    return (ssize_t)total;
+}
+#endif
diff --git a/native/lc2_gl_format.h b/native/lc2_gl_format.h
new file mode 100644
index 0000000..bc1377e
--- /dev/null
+++ b/native/lc2_gl_format.h
@@ -0,0 +1,83 @@
+/* GLES upload triples for decoded texture payloads.
+ *
+ * A sized internal format is storage; the last `format`/`type` pair passed to
+ * glTexImage2D/glTexSubImage2D describes the CLIENT array and is never the
+ * internal-format enum. Passing GL_SRGB_ALPHA_EXT (0x8C42) in both places is
+ * not a legal GLES2 or GLES3 call, so this helper keeps the two roles apart.
+ *
+ * Rules (roadmap 32.3):
+ *   decoded 8-bit sRGB RGBA  -> sized sRGB internal, GL_RGBA, GL_UNSIGNED_BYTE
+ *   decoded 8-bit linear RGBA-> sized RGBA8 (ES3) or unsized GL_RGBA (ES2)
+ *   verified float           -> RGBA32F (ES3) or unsized GL_RGBA (ES2), GL_FLOAT
+ * Anything else is refused: this helper never coerces unknown data to RGBA8.
+ *
+ * Storage difference between the two context generations is real: GLES2 has no
+ * sized colour formats, and on GLES2 the only legal sRGB internal format comes
+ * from GL_EXT_sRGB (0x8C42). GL_SRGB8_ALPHA8 (0x8C43) is GLES3-only and must
+ * not be emitted into an ES2 context.
+ */
+#ifndef LC2_GL_FORMAT_H
+#define LC2_GL_FORMAT_H
+#include <stdint.h>
+
+#define LC2_GL_RGBA          0x1908U  /* client format and unsized ES2 storage */
+#define LC2_GL_RGBA8         0x8058U  /* sized, GLES3 */
+#define LC2_GL_SRGB8_ALPHA8  0x8C43U  /* sized sRGB, GLES3 */
+#define LC2_GL_SRGB_ALPHA_EXT 0x8C42U /* sRGB storage, GLES2 + GL_EXT_sRGB */
+#define LC2_GL_RGBA32F       0x8814U  /* sized float, GLES3 */
+#define LC2_GL_UNSIGNED_BYTE 0x1401U
+#define LC2_GL_FLOAT         0x1406U
+
+enum lc2_gl_format_status {
+    LC2_GL_FORMAT_OK = 0,
+    LC2_GL_FORMAT_UNSUPPORTED = 1,      /* no tested triple for this payload */
+    LC2_GL_FORMAT_SRGB_UNAVAILABLE = 2, /* sRGB storage is not expressible here */
+    LC2_GL_FORMAT_CONTEXT_INVALID = 3   /* unknown/unsupported API generation */
+};
+
+struct lc2_gl_upload {
+    uint32_t internal, external, type;
+};
+
+static inline enum lc2_gl_format_status lc2_gl_upload_format(unsigned api_major,
+        unsigned srgb_extension, unsigned source_srgb, unsigned upload_type,
+        struct lc2_gl_upload *out) {
+    if (!out || api_major < 2) return LC2_GL_FORMAT_CONTEXT_INVALID;
+    const int es3 = api_major >= 3;
+    if (source_srgb) {
+        /* sRGB storage decodes on sample, so only 8-bit source data applies. */
+        if (upload_type != LC2_GL_UNSIGNED_BYTE) return LC2_GL_FORMAT_UNSUPPORTED;
+        if (es3) out->internal = LC2_GL_SRGB8_ALPHA8;
+        else if (srgb_extension) out->internal = LC2_GL_SRGB_ALPHA_EXT;
+        else return LC2_GL_FORMAT_SRGB_UNAVAILABLE;
+        out->external = LC2_GL_RGBA;
+        out->type = LC2_GL_UNSIGNED_BYTE;
+        return LC2_GL_FORMAT_OK;
+    }
+    if (upload_type == LC2_GL_UNSIGNED_BYTE) {
+        out->internal = es3 ? LC2_GL_RGBA8 : LC2_GL_RGBA;
+    } else if (upload_type == LC2_GL_FLOAT) {
+        out->internal = es3 ? LC2_GL_RGBA32F : LC2_GL_RGBA;
+    } else {
+        return LC2_GL_FORMAT_UNSUPPORTED;
+    }
+    out->external = LC2_GL_RGBA;
+    out->type = upload_type;
+    return LC2_GL_FORMAT_OK;
+}
+
+/* A subimage only names the client array; storage was fixed by the matching
+ * glTexImage2D. Same refusal rules as above, so an sRGB texture cannot be
+ * updated through a linear client triple by accident. */
+static inline enum lc2_gl_format_status lc2_gl_subimage_format(unsigned source_srgb,
+        unsigned upload_type, struct lc2_gl_upload *out) {
+    if (!out) return LC2_GL_FORMAT_CONTEXT_INVALID;
+    if (source_srgb && upload_type != LC2_GL_UNSIGNED_BYTE) return LC2_GL_FORMAT_UNSUPPORTED;
+    if (!source_srgb && upload_type != LC2_GL_UNSIGNED_BYTE && upload_type != LC2_GL_FLOAT)
+        return LC2_GL_FORMAT_UNSUPPORTED;
+    out->internal = 0; /* unused by glTexSubImage2D */
+    out->external = LC2_GL_RGBA;
+    out->type = upload_type;
+    return LC2_GL_FORMAT_OK;
+}
+#endif
diff --git a/native/lc2_gl_storage.h b/native/lc2_gl_storage.h
new file mode 100644
index 0000000..fe6aa9f
--- /dev/null
+++ b/native/lc2_gl_storage.h
@@ -0,0 +1,106 @@
+/* G0: pure, checked FORMAT-DEFINED image payload, not Mali physical residency.
+ * Explicit sized GL internal format only; never infer it from guest BC bytes,
+ * an unsized GL_RGBA/GL_SRGB_ALPHA enum, or an external upload type.
+ * No GL/guest reads, allocations, budget mutation or texture-policy selection.
+ * Alignment, tiling, driver metadata and deferred/in-flight storage are unknown.
+ * A caller must separately prove API/extension support, realized sample count,
+ * context/storage generation, alias ownership and actual allocation lifetime.
+ */
+#ifndef LC2_GL_STORAGE_H
+#define LC2_GL_STORAGE_H
+#include <stdint.h>
+#include <limits.h>
+
+#define LC2_GL_STORAGE_LEVELS 31U /* positive GLsizei dimensions <= INT32_MAX */
+enum lc2_gl_storage_status {LC2_GL_STORAGE_OK,LC2_GL_STORAGE_FORMAT,
+    LC2_GL_STORAGE_DESCRIPTOR,LC2_GL_STORAGE_OVERFLOW};
+struct lc2_gl_storage_desc {
+    uint32_t target,internal_format,width,height,depth,layers,levels,samples;
+    /* layers = cube COUNT for GL_TEXTURE_CUBE_MAP_ARRAY; depth is 3D only.
+     * samples = realized storage samples (1 for single-sample), NOT NVN's 0.
+     * A requested 2x count is not evidence the driver did not round it to 4x. */
+};
+struct lc2_gl_storage_level {
+    uint32_t width,height,depth;
+    uint64_t slices,offset,bytes;
+};
+struct lc2_gl_storage_layout {
+    uint64_t bytes;
+    uint32_t levels;
+    struct lc2_gl_storage_level level[LC2_GL_STORAGE_LEVELS];
+};
+static inline int lc2_gl_storage_mul(uint64_t a,uint64_t b,uint64_t *result) {
+    if(b && a>UINT64_MAX/b)return 0;
+    *result=a*b;return 1;
+}
+static inline enum lc2_gl_storage_status lc2_gl_storage_calculate(
+        const struct lc2_gl_storage_desc *d,struct lc2_gl_storage_layout *out) {
+    if(!d || !out)return LC2_GL_STORAGE_DESCRIPTOR;
+    unsigned bw=1,bh=1,block_bytes=0,compressed=0;
+    switch(d->internal_format) {
+    case 0x8229: block_bytes=1;break; /* R8 */
+    case 0x822b: case 0x8056: case 0x8057: case 0x81a5:
+        block_bytes=2;break; /* RG8, RGBA4, RGB5_A1, DEPTH_COMPONENT16 */
+    case 0x8051: block_bytes=3;break; /* RGB8 */
+    case 0x8058: case 0x8c43: case 0x88f0:
+        block_bytes=4;break; /* RGBA8, SRGB8_ALPHA8, DEPTH24_STENCIL8 */
+    case 0x881a: block_bytes=8;break; /* RGBA16F */
+    case 0x8814: block_bytes=16;break; /* RGBA32F */
+    case 0x83f1: case 0x8c4d: /* BC1 RGBA, sRGB BC1 RGBA */
+        bw=bh=4;block_bytes=8;compressed=1;break;
+    case 0x83f3: case 0x8c4f: /* BC3 RGBA, sRGB BC3 RGBA */
+    case 0x9278: case 0x9279: /* ETC2/EAC RGBA8, sRGB8_ALPHA8 */
+        bw=bh=4;block_bytes=16;compressed=1;break;
+    case 0x93b0: case 0x93d0: /* ASTC 4x4 RGBA, sRGB */
+        bw=bh=4;block_bytes=16;compressed=1;break;
+    case 0x93b4: case 0x93d4: /* ASTC 6x6 RGBA, sRGB */
+        bw=bh=6;block_bytes=16;compressed=1;break;
+    default:return LC2_GL_STORAGE_FORMAT;
+    }
+    if(!d->width || !d->height || !d->depth || !d->layers || !d->samples ||
+       d->width>INT32_MAX || d->height>INT32_MAX || d->depth>INT32_MAX ||
+       d->layers>INT32_MAX || d->samples>INT32_MAX || !d->levels ||
+       d->levels>LC2_GL_STORAGE_LEVELS)return LC2_GL_STORAGE_DESCRIPTOR;
+    unsigned is_3d=0,is_array=0,is_ms=0,is_rb=0,faces=1;
+    switch(d->target) {
+    case 0x0de1: break; /* TEXTURE_2D */
+    case 0x806f: is_3d=1;break; /* TEXTURE_3D */
+    case 0x8c1a: is_array=1;break; /* TEXTURE_2D_ARRAY */
+    case 0x8513: faces=6;break; /* TEXTURE_CUBE_MAP */
+    case 0x9009: faces=6;is_array=1;break; /* TEXTURE_CUBE_MAP_ARRAY */
+    case 0x9100: is_ms=1;break; /* TEXTURE_2D_MULTISAMPLE */
+    case 0x9102: is_ms=1;is_array=1;break; /* TEXTURE_2D_MULTISAMPLE_ARRAY */
+    case 0x8d41: is_ms=1;is_rb=1;break; /* RENDERBUFFER, realized sample count */
+    default:return LC2_GL_STORAGE_DESCRIPTOR;
+    }
+    if((!is_3d && d->depth!=1) || (!is_array && d->layers!=1) ||
+       (!is_ms && d->samples!=1) || (faces==6 && d->width!=d->height) ||
+       (faces==6 && d->layers>(uint32_t)INT32_MAX/6) ||
+       ((is_ms || is_rb) && d->levels!=1) ||
+       (compressed && (is_ms || is_3d)))return LC2_GL_STORAGE_DESCRIPTOR;
+    uint32_t largest=d->width>d->height?d->width:d->height;
+    if(is_3d && d->depth>largest)largest=d->depth;
+    unsigned max_levels=0;
+    do {max_levels++;largest>>=1;}while(largest);
+    if(d->levels>max_levels)return LC2_GL_STORAGE_DESCRIPTOR;
+    struct lc2_gl_storage_layout plan={0};plan.levels=d->levels;
+    uint32_t width=d->width,height=d->height,depth=d->depth;
+    for(unsigned i=0;i<d->levels;i++) {
+        uint64_t x=width/bw+(width%bw!=0),y=height/bh+(height%bh!=0),bytes,slices;
+        if(!lc2_gl_storage_mul(depth,d->layers,&slices) ||
+           !lc2_gl_storage_mul(slices,faces,&slices) ||
+           !lc2_gl_storage_mul(x,y,&bytes) ||
+           !lc2_gl_storage_mul(bytes,block_bytes,&bytes) ||
+           !lc2_gl_storage_mul(bytes,slices,&bytes) ||
+           !lc2_gl_storage_mul(bytes,d->samples,&bytes) ||
+           plan.bytes>UINT64_MAX-bytes)return LC2_GL_STORAGE_OVERFLOW;
+        plan.level[i]=(struct lc2_gl_storage_level){width,height,depth,slices,plan.bytes,bytes};
+        plan.bytes+=bytes;
+        if(width>1)width>>=1;
+        if(height>1)height>>=1;
+        if(is_3d && depth>1)depth>>=1;
+    }
+    /* Publish once: invalid/overflowed descriptors leave the entire output alone. */
+    *out=plan;return LC2_GL_STORAGE_OK;
+}
+#endif
diff --git a/native/lc2_guest_quota.h b/native/lc2_guest_quota.h
new file mode 100644
index 0000000..f54c2b6
--- /dev/null
+++ b/native/lc2_guest_quota.h
@@ -0,0 +1,12 @@
+/* Diagnostic guest virtual-allocation quota; not physical RAM admission. */
+#ifndef LC2_GUEST_QUOTA_H
+#define LC2_GUEST_QUOTA_H
+#include <stdint.h>
+#include <stdlib.h>
+static int lc2_guest_quota_parse(const char *option,uint64_t *bytes) {
+    if(!option){*bytes=1536ULL<<20;return 0;}
+    char *end;unsigned long long mib=strtoull(option,&end,10);
+    if(end==option || *end || mib<1536 || mib>3072)return -1;
+    *bytes=(uint64_t)mib<<20;return 0;
+}
+#endif
diff --git a/native/lc2_hid109.h b/native/lc2_hid109.h
new file mode 100644
index 0000000..ddc43c2
--- /dev/null
+++ b/native/lc2_hid109.h
@@ -0,0 +1,48 @@
+/* SDK 10.9.0.0 npad shared-memory record: measured from the title's own reader.
+ *
+ * nn::hid::detail::GetNpadStates (sdk+0x208a40) dereferences the pointer held at
+ * shared+0x18+8*id, then reads [block+0x40] (count, clamped to the requested
+ * number) and [block+0x38] (ring tail), and copies 0x28 bytes from
+ * block+0x48+(tail%17)*0x30+8 into the caller's NpadFullKeyState. The slot is
+ * therefore {u64 sequence; 0x28-byte sample} and the ring holds 17 slots.
+ *
+ * Diagnostic only: nothing here is enabled unless LC2_HID_SDK109=1.
+ */
+#ifndef LC2_HID109_H
+#define LC2_HID109_H
+#include <stdint.h>
+#include <string.h>
+
+#define LC2_HID109_TABLE 0x18U
+#define LC2_HID109_BLOCK_BASE 0x1000U
+#define LC2_HID109_BLOCK_STRIDE 0x400U
+#define LC2_HID109_TAIL 0x38U
+#define LC2_HID109_COUNT 0x40U
+#define LC2_HID109_RING 0x48U
+#define LC2_HID109_SLOT 0x30U
+#define LC2_HID109_SLOTS 17U
+#define LC2_HID109_SAMPLE 0x28U
+
+static inline uint32_t lc2_hid109_block_offset(unsigned id) {
+    return LC2_HID109_BLOCK_BASE + LC2_HID109_BLOCK_STRIDE * id;
+}
+
+/* Publish one sample into one block. `sample` is the 0x28-byte npad payload
+ * (sampling number, buttons, four stick axes, attributes, reserved). Returns the
+ * slot index used. */
+static inline unsigned lc2_hid109_publish(uint8_t *block, uint64_t sequence,
+                                          const void *sample, size_t size) {
+    uint64_t tail = 0, count = 0;
+    memcpy(&tail, block + LC2_HID109_TAIL, 8);
+    memcpy(&count, block + LC2_HID109_COUNT, 8);
+    tail = (tail + 1) % LC2_HID109_SLOTS;
+    if (count < LC2_HID109_SLOTS) count++;
+    memcpy(block + LC2_HID109_TAIL, &tail, 8);
+    memcpy(block + LC2_HID109_COUNT, &count, 8);
+    uint8_t *slot = block + LC2_HID109_RING + tail * LC2_HID109_SLOT;
+    memcpy(slot, &sequence, 8);
+    memset(slot + 8, 0, LC2_HID109_SAMPLE);
+    memcpy(slot + 8, sample, size < LC2_HID109_SAMPLE ? size : LC2_HID109_SAMPLE);
+    return (unsigned)tail;
+}
+#endif
diff --git a/native/lc2_hid_watch.h b/native/lc2_hid_watch.h
new file mode 100644
index 0000000..1bde144
--- /dev/null
+++ b/native/lc2_hid_watch.h
@@ -0,0 +1,54 @@
+/* Diagnostic first-access watch on the guest's read-only HID mapping.
+ * The writer alias stays writable. No HID content or guest code is changed.
+ * Each page is restored once. A later fault on it is NOT swallowed (e.g. writes).
+ */
+#ifndef LC2_HID_WATCH_H
+#define LC2_HID_WATCH_H
+#include <stdint.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+static uintptr_t lc2_hid_watch_guest;
+static size_t lc2_hid_watch_size,lc2_hid_watch_page_size;
+static unsigned lc2_hid_watch_armed,lc2_hid_watch_hits;
+static uint64_t lc2_hid_watch_restored[16]; /* at most 1024 pages */
+static inline size_t lc2_hid_watch_page(void) { return (size_t)sysconf(_SC_PAGESIZE); }
+static inline int lc2_hid_watch_arm(uint64_t guest,size_t size) {
+    size_t page=lc2_hid_watch_page();
+    if(!guest || guest%page || !size || size%page || size>(4U<<20) || size/page>1024)return 0;
+    lc2_hid_watch_guest=(uintptr_t)guest;lc2_hid_watch_size=size;lc2_hid_watch_page_size=page;
+    for(unsigned i=0;i<16;i++)__atomic_store_n(&lc2_hid_watch_restored[i],0,__ATOMIC_RELAXED);
+    __atomic_store_n(&lc2_hid_watch_armed,1,__ATOMIC_RELEASE);
+    if(mprotect((void *)(uintptr_t)guest,size,PROT_NONE)) {
+        __atomic_store_n(&lc2_hid_watch_armed,0,__ATOMIC_RELEASE);return 0;
+    }
+    return 1;
+}
+static inline char *lc2_hid_watch_text(char *p,const char *s) { while(*s)*p++=*s++;return p; }
+static inline char *lc2_hid_watch_hex(char *p,uint64_t n) {
+    char digits[16];unsigned count=0;
+    do {digits[count++]="0123456789abcdef"[n&15];n>>=4;}while(n);
+    while(count)*p++=digits[--count];
+    return p;
+}
+static inline int lc2_hid_watch_fault(uintptr_t address,uintptr_t pc) {
+    if(!__atomic_load_n(&lc2_hid_watch_armed,__ATOMIC_ACQUIRE))return 0;
+    if(address<lc2_hid_watch_guest || address-lc2_hid_watch_guest>=lc2_hid_watch_size)return 0;
+    size_t page=lc2_hid_watch_page_size,index=(address-lc2_hid_watch_guest)/page;
+    uint64_t mask=UINT64_C(1)<<(index%64);
+    if(__atomic_load_n(&lc2_hid_watch_restored[index/64],__ATOMIC_ACQUIRE)&mask)return 0;
+    uintptr_t base=lc2_hid_watch_guest+index*page;
+    if(mprotect((void *)base,page,PROT_READ))return 0;
+    uint64_t old=__atomic_fetch_or(&lc2_hid_watch_restored[index/64],mask,__ATOMIC_ACQ_REL);
+    if(!(old&mask)) {
+        __atomic_add_fetch(&lc2_hid_watch_hits,1,__ATOMIC_RELAXED);
+        /* write is async-signal-safe; no stdio or allocation in this handler. */
+        char line[192],*p=line;
+        p=lc2_hid_watch_text(p,"LC2_HID_WATCH_READ offset=0x");p=lc2_hid_watch_hex(p,base-lc2_hid_watch_guest);
+        p=lc2_hid_watch_text(p," address=0x");p=lc2_hid_watch_hex(p,address);
+        p=lc2_hid_watch_text(p," pc=0x");p=lc2_hid_watch_hex(p,pc);*p++='\n';
+        ssize_t written=write(STDOUT_FILENO,line,(size_t)(p-line));(void)written;
+    }
+    return 1;
+}
+#endif
diff --git a/native/lc2_input_latch.h b/native/lc2_input_latch.h
new file mode 100644
index 0000000..fbe5673
--- /dev/null
+++ b/native/lc2_input_latch.h
@@ -0,0 +1,88 @@
+/* Tap latch: a physical button press can be shorter than one guest frame.
+ *
+ * Measured on this device: the title renders at roughly 1-2 frames per second while it
+ * loads, so a 100-200 ms human tap starts and ends entirely between two guest samples
+ * and the title never sees it. The pad path itself is fine (the adapter publishes every
+ * ~8 ms and the guest reads the canonical Npad records), so the loss is purely sampling.
+ *
+ * This keeps a bit asserted for one measured guest frame interval after release, so an
+ * edge-triggered menu still sees exactly one press. It changes latency, not semantics:
+ * a bit is never held longer than one frame plus a margin, and holding a button behaves
+ * exactly as before. Two taps inside the same frame merge into one, which is the correct
+ * reading at that frame rate.
+ *
+ * Pure function of (time, present counter, buttons) so it is unit-testable off-device.
+ * LC2_INPUT_MIN_HOLD_MS forces a fixed window (milliseconds, 0 disables) for A/B runs.
+ */
+#ifndef LC2_INPUT_LATCH_H
+#define LC2_INPUT_LATCH_H
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define LC2_INPUT_LATCH_FLOOR_MS 120u
+#define LC2_INPUT_LATCH_MARGIN_MS 80u
+#define LC2_INPUT_LATCH_CEIL_MS 900u
+
+struct lc2_input_latch {
+    uint64_t deadline[64];
+    uint64_t active;
+    uint64_t interval;
+    uint64_t last_change;
+    uint64_t window;
+    unsigned last_frame;
+    long forced;
+    int configured;
+    int disabled;
+};
+
+static uint64_t lc2_input_latch_window(struct lc2_input_latch *s, uint64_t now, unsigned frame) {
+    if (!s->configured) {
+        /* Opt-in until an end-to-end device A/B proves it: LC2_INPUT_LATCH=1 enables the
+         * adaptive window, and LC2_INPUT_MIN_HOLD_MS forces a fixed one for measurement. */
+        const char *on = getenv("LC2_INPUT_LATCH");
+        if (!(on && !strcmp(on, "1"))) s->disabled = 1;
+        const char *o = getenv("LC2_INPUT_MIN_HOLD_MS");
+        s->forced = o ? strtol(o, 0, 10) : -1;
+        if (s->forced > (long)LC2_INPUT_LATCH_CEIL_MS) s->forced = LC2_INPUT_LATCH_CEIL_MS;
+        if (s->forced < 0) s->forced = -1;
+        s->configured = 1;
+    }
+    if (frame != s->last_frame) {
+        if (s->last_frame && now > s->last_change) s->interval = now - s->last_change;
+        s->last_frame = frame;
+        s->last_change = now;
+    }
+    uint64_t window;
+    if (s->forced >= 0) {
+        window = (uint64_t)s->forced;
+    } else {
+        window = s->interval > LC2_INPUT_LATCH_FLOOR_MS
+                     ? s->interval + LC2_INPUT_LATCH_MARGIN_MS
+                     : LC2_INPUT_LATCH_FLOOR_MS;
+        if (window > LC2_INPUT_LATCH_CEIL_MS) window = LC2_INPUT_LATCH_CEIL_MS;
+    }
+    s->window = window;
+    return window;
+}
+
+static uint64_t lc2_input_latch_apply(struct lc2_input_latch *s, uint64_t now,
+                                      unsigned frame, uint64_t buttons) {
+    uint64_t window = lc2_input_latch_window(s, now, frame);
+    if (s->disabled) return buttons;
+    if (!window) return buttons;
+    uint64_t extra = 0;
+    for (unsigned b = 0; b < 64; b++) {
+        uint64_t bit = 1ULL << b;
+        if (buttons & bit) {
+            s->active |= bit;
+            s->deadline[b] = now + window;
+        } else if (s->active & bit) {
+            if (now < s->deadline[b]) extra |= bit;
+            else s->active &= ~bit;
+        }
+    }
+    return buttons | extra;
+}
+
+#endif
diff --git a/native/lc2_menu_ledger.h b/native/lc2_menu_ledger.h
new file mode 100644
index 0000000..e901882
--- /dev/null
+++ b/native/lc2_menu_ledger.h
@@ -0,0 +1,175 @@
+/* MENU_MEMORY_LEDGER (owner roadmap 40.5 M0): measurement without behaviour change.
+ *
+ * One line at most once per second while enabled, plus a forced line at the
+ * first presented frame and immediately before a memory-floor refusal. Reads only
+ * host-side files and in-process counters: no guest memory, no allocation, no
+ * change to admission, budgets, floors or swap policy.
+ *
+ * Deliberately labelled: values that are not measured say `untracked` instead of
+ * carrying a zero, because a zero in a ledger is read as "nothing allocated".
+ */
+#ifndef LC2_MENU_LEDGER_H
+#define LC2_MENU_LEDGER_H
+#include <time.h>
+
+static struct {
+    unsigned configured, enabled, lines, forced_first, forced_floor;
+    uint64_t last_ns, first_present_ns;
+    uint64_t base_available_kib;
+    unsigned started;
+} lc2_menu_ledger;
+
+static uint64_t lc2_menu_ledger_now_ns(void) {
+    struct timespec ts;clock_gettime(CLOCK_MONOTONIC,&ts);
+    return (uint64_t)ts.tv_sec*1000000000ULL+(uint64_t)ts.tv_nsec;
+}
+
+static unsigned long lc2_menu_ledger_meminfo(const char *key) {
+    FILE *file=fopen("/proc/meminfo","r");if(!file)return 0;
+    char line[256];unsigned long value=0;
+    size_t length=strlen(key);
+    while(fgets(line,sizeof line,file)) {
+        if(!strncmp(line,key,length) && line[length]==':') {value=strtoul(line+length+1,NULL,10);break;}
+    }
+    fclose(file);return value;
+}
+
+static void lc2_menu_ledger_status(unsigned long *rss_kib,unsigned long *swap_kib) {
+    *rss_kib=0;*swap_kib=0;
+    FILE *file=fopen("/proc/self/status","r");if(!file)return;
+    char line[256];
+    while(fgets(line,sizeof line,file)) {
+        if(!strncmp(line,"VmRSS:",6))*rss_kib=strtoul(line+6,NULL,10);
+        else if(!strncmp(line,"VmSwap:",7))*swap_kib=strtoul(line+7,NULL,10);
+    }
+    fclose(file);
+}
+
+
+/* Opt-in per-target receipt (LC2_MENU_LEDGER=1). Emitted at most once per run, when
+ * available memory first crosses below 64 MiB, i.e. before the floor refusal. Names
+ * every colour target the adapter has drawn into or marked as a composition target,
+ * with the counters it already tracks. `last-used-serial=untracked` is deliberate:
+ * no last-reader epoch exists yet (that is the B2 ledger work). */
+static void lc2_menu_ledger_targets(const char *why,unsigned frames) {
+    static unsigned emitted;
+    if(emitted)return;
+    emitted=1;
+    unsigned listed=0;
+    for(unsigned i=0;i<4096 && listed<32;i++) {
+        struct nvn_texture *t=&nvn_textures[i];
+        if(!t->live || !(t->composition_target_seen || t->draws))continue;
+        listed++;
+        printf("LC2_MENU_TARGET why=%s frames=%u id=%"PRIu64" object=0x%"PRIx64
+               " size=%ux%u format=0x%x levels=%u charged-bytes=%"PRIu64" guest-bytes=%"PRIu64
+               " draws=%u target-seen=%u references=%u depth-buffer=%u name=%u"
+               " last-used-serial=untracked resident-bytes=unknown\n",
+               why,frames,t->id,t->object,t->b.width,t->b.height,t->b.format,t->b.levels,
+               t->t2_budget_bytes,t->size,t->draws,t->composition_target_seen,t->references,
+               t->depth_buffer,t->name);
+    }
+    printf("LC2_MENU_TARGETS_DONE why=%s listed=%u scope=adapter-known only\n",why,listed);
+}
+
+static void lc2_menu_ledger_emit(const char *why,unsigned frames) {
+    unsigned long rss,swap;lc2_menu_ledger_status(&rss,&swap);
+    unsigned long available=lc2_menu_ledger_meminfo("MemAvailable");
+    if(!lc2_menu_ledger.base_available_kib)lc2_menu_ledger.base_available_kib=available;
+    /* Per-class attribution from adapter state only (B2-lite): every value is a
+     * format-defined estimate for a class we actually create, never driver
+     * residency. Classes the adapter cannot see stay `untracked`. */
+    uint64_t live_textures=0,charged=0,guest_storage=0;
+    uint64_t depth_buffers=0,depth_bytes=0,color_targets=0,color_target_bytes=0;
+    uint64_t scaled_textures=0,scaled_bytes=0,half_textures=0,bc_pending=0,joined=0;
+    for(unsigned i=0;i<4096;i++) {
+        struct nvn_texture *t=&nvn_textures[i];
+        if(!t->live)continue;
+        live_textures++;charged+=t->t2_budget_bytes;guest_storage+=t->size;
+        unsigned width=t->host_scaled?t->host_width:t->b.width;
+        unsigned height=t->host_scaled?t->host_height:t->b.height;
+        uint64_t pixels=(uint64_t)width*height;
+        /* GL_DEPTH24_STENCIL8_OES (0x88f0) is 4 bytes per pixel: the earlier
+         * 8-byte estimate doubled the depth class (corrected against lc2_alloc receipts). */
+        if(t->depth_buffer) {depth_buffers++;depth_bytes+=pixels*4U;}
+        if(t->composition_target_seen||t->draws) {color_targets++;color_target_bytes+=pixels*4U;}
+        if(t->host_scaled||t->host_half) {scaled_textures++;scaled_bytes+=pixels*4U;}
+        if(t->b.format>=0x41 && t->b.format<=0x50 && t->lc2_bc_pending)bc_pending++;
+        if(zero_texture_storage_state(t)!=t)joined++;
+    }
+    pthread_mutex_lock(&t2_texture_budget_mutex);
+    uint64_t budget_live=t2_texture_budget.live_bytes,budget_peak=t2_texture_budget.peak_bytes,
+             budget_count=t2_texture_budget.count;
+    pthread_mutex_unlock(&t2_texture_budget_mutex);
+    uint64_t now=lc2_menu_ledger_now_ns();
+    if(!lc2_menu_ledger.first_present_ns)lc2_menu_ledger.first_present_ns=now;
+    printf("LC2_MENU_LEDGER why=%s t-ms=%llu frames=%u line=%u"
+           " available-kib=%lu base-available-kib=%llu delta-kib=%lld cmafree-kib=%lu"
+           " cached-kib=%lu anonpages-kib=%lu shmem-kib=%lu swapfree-kib=%lu"
+           " vmrss-kib=%lu vmswap-kib=%lu"
+           " budget-live-bytes=%llu budget-peak-bytes=%llu budget-charges=%llu"
+           " textures-live=%llu textures-charged-bytes=%llu guest-storage-bytes=%llu"
+           " depth-renderbuffers=%llu depth-estimate-bytes=%llu color-targets=%llu color-target-estimate-bytes=%llu"
+           " scaled-textures=%llu scaled-estimate-bytes=%llu half-textures=%llu bc-pending=%llu joined-views=%llu"
+           " renderbuffers=untracked buffers=untracked egl-surfaces=untracked"
+           " driver-physical=unknown guest-heap=untracked"
+           " scope=host-observable diagnostic=1 behaviour=unchanged\n",
+           why,(unsigned long long)((now-lc2_menu_ledger.first_present_ns)/1000000ULL),frames,
+           lc2_menu_ledger.lines,available,(unsigned long long)lc2_menu_ledger.base_available_kib,
+           (long long)((long long)available-(long long)lc2_menu_ledger.base_available_kib),
+           lc2_menu_ledger_meminfo("CmaFree"),lc2_menu_ledger_meminfo("Cached"),
+           lc2_menu_ledger_meminfo("AnonPages"),lc2_menu_ledger_meminfo("Shmem"),
+           lc2_menu_ledger_meminfo("SwapFree"),rss,swap,
+           (unsigned long long)budget_live,(unsigned long long)budget_peak,(unsigned long long)budget_count,
+           (unsigned long long)live_textures,(unsigned long long)charged,(unsigned long long)guest_storage,
+           (unsigned long long)depth_buffers,(unsigned long long)depth_bytes,
+           (unsigned long long)color_targets,(unsigned long long)color_target_bytes,
+           (unsigned long long)scaled_textures,(unsigned long long)scaled_bytes,
+           (unsigned long long)half_textures,(unsigned long long)bc_pending,(unsigned long long)joined);
+    lc2_menu_ledger.lines++;fflush(stdout);
+}
+
+/* Called once from GL/texture initialisation: the biggest GL images (three
+ * 1920x1080 colour targets plus their depth) are allocated BEFORE the first
+ * present, so a series that starts at the first frame bakes them into its baseline. */
+static void lc2_menu_ledger_start(void) {
+    if(!lc2_menu_ledger.configured) {
+        const char *option=getenv("LC2_MENU_LEDGER");
+        lc2_menu_ledger.enabled=option && !strcmp(option,"1");
+        lc2_menu_ledger.configured=1;
+        lc2_menu_ledger.first_present_ns=lc2_menu_ledger_now_ns();
+    }
+    if(!lc2_menu_ledger.enabled || lc2_menu_ledger.started)return;
+    lc2_menu_ledger.started=1;
+    lc2_menu_ledger_emit("gl-init",0);
+}
+
+/* Called from the present path. `first` marks the first presented frame of the run. */
+static void lc2_menu_ledger_tick(unsigned frames,unsigned first) {
+    if(!lc2_menu_ledger.configured) {
+        const char *option=getenv("LC2_MENU_LEDGER");
+        lc2_menu_ledger.enabled=option && !strcmp(option,"1");
+        lc2_menu_ledger.configured=1;
+        if(lc2_menu_ledger.enabled) {
+            lc2_menu_ledger.first_present_ns=lc2_menu_ledger_now_ns();
+            lc2_menu_ledger_emit("arm-start",frames);
+            return;
+        }
+    }
+    if(!lc2_menu_ledger.enabled)return;
+    uint64_t now=lc2_menu_ledger_now_ns();
+    if(first && !lc2_menu_ledger.forced_first) {
+        lc2_menu_ledger.forced_first=1;lc2_menu_ledger_emit("first-present",frames);
+        lc2_menu_ledger.last_ns=now;return;
+    }
+    if(now-lc2_menu_ledger.last_ns<1000000000ULL)return;
+    lc2_menu_ledger.last_ns=now;
+    lc2_menu_ledger_emit("interval",frames);
+    if(lc2_menu_ledger_meminfo("MemAvailable")<65536UL)lc2_menu_ledger_targets("pre-floor-targets",frames);
+}
+
+/* Called where the floor decides to stop the run: the ledger must survive the exit. */
+static void lc2_menu_ledger_floor(void) {
+    if(!lc2_menu_ledger.enabled || lc2_menu_ledger.forced_floor)return;
+    lc2_menu_ledger.forced_floor=1;lc2_menu_ledger_emit("pre-floor-stop",0);
+}
+#endif
diff --git a/native/lc2_menu_trace.h b/native/lc2_menu_trace.h
new file mode 100644
index 0000000..b39d919
--- /dev/null
+++ b/native/lc2_menu_trace.h
@@ -0,0 +1,79 @@
+/* Diagnostic semantic tracing of the owner's hash-pinned Lamentum main.
+ * Changes only the adapter's private executable mapping, never image files.
+ * Replays the exact original entry instruction; no API result/state is replaced.
+ */
+#ifndef LC2_MENU_TRACE_H
+#define LC2_MENU_TRACE_H
+static unsigned lc2_menu_trace_enabled;
+static const struct {uint32_t offset,opcode;const char *name;} lc2_menu_sites[]={
+    {0x16cb4c0,0xd10203ff,"ManagerMenuPrincipal.Start"},
+    {0x16cbb00,0xd102c3ff,"ManagerMenuPrincipal.GetResolutions"},
+    {0x1a6af50,0xf81d0ff5,"GameObject.SetActive"},
+    {0x1d6770,0xa9bf7bfd,"il2cpp-null-check-helper"},
+    {0x1d66c0,0xa9bf7bfd,"il2cpp-raise-helper"}
+};
+static void lc2_menu_trace_configure(void) {
+    const char *v=getenv("LC2_MENU_TRACE");lc2_menu_trace_enabled=v&&!strcmp(v,"1");
+    if(lc2_menu_trace_enabled)printf("LC2_MENU_TRACE enabled=1 sites=5 scope=diagnostic-original-prologue-replay\n");
+}
+static int lc2_menu_site(uint64_t pc) {
+    if(!lc2_menu_trace_enabled || pc<LC2_MAIN_BASE)return -1;
+    uint64_t offset=pc-LC2_MAIN_BASE;
+    for(unsigned i=0;i<sizeof(lc2_menu_sites)/sizeof(lc2_menu_sites[0]);i++)
+        if(offset==lc2_menu_sites[i].offset)return (int)i;
+    return -1;
+}
+static unsigned lc2_menu_trace_entry(uint64_t pc,uint32_t opcode) {
+    int i=lc2_menu_site(pc);if(i<0)return 0;
+    if(opcode!=lc2_menu_sites[i].opcode)stop("LC2_MENU_TRACE_IDENTITY",pc,opcode,24);
+    return 1;
+}
+static void lc2_menu_trace_string(struct line *log,uint64_t address) {
+    for(unsigned i=0;i<80;i++) {
+        if(!accessible(address+i,1,PROT_READ)){text(log,"<unreadable>");return;}
+        unsigned char c=*(const unsigned char *)(uintptr_t)(address+i);
+        if(!c)return;
+        if(c<32 || c>126){text(log,"<non-ascii>");return;}
+        char word[2]={(char)c,0};text(log,word);
+    }
+}
+static unsigned lc2_menu_trace_handle(uint64_t pc,uint32_t opcode,ucontext_t *ctx) {
+    int index=lc2_menu_site(pc);if(index<0)return 0;
+    if(opcode!=lc2_menu_sites[index].opcode)stop("LC2_MENU_TRACE_IDENTITY",pc,opcode,24);
+    uint64_t caller=ctx->uc_mcontext.regs[30];
+    static unsigned counts[5];
+    unsigned relevant=index!=2 || (caller>=LC2_MAIN_BASE+0x16cb4c0 && caller<LC2_MAIN_BASE+0x16cbaa0);
+    if(relevant && __atomic_fetch_add(&counts[index],1,__ATOMIC_RELAXED)<32) {
+        struct line log={0};text(&log,"LC2_MENU_EVENT name=");text(&log,lc2_menu_sites[index].name);
+        text(&log," caller=");location(&log,caller);
+        text(&log," x0=");hex(&log,ctx->uc_mcontext.regs[0]);
+        text(&log," x1=");hex(&log,ctx->uc_mcontext.regs[1]);
+        if(index==4) {
+            uint64_t object=ctx->uc_mcontext.regs[0],klass=0,name=0;
+            if(accessible(object,8,PROT_READ))memcpy(&klass,(void *)(uintptr_t)object,8);
+            if(klass && accessible(klass+16,8,PROT_READ))memcpy(&name,(void *)(uintptr_t)(klass+16),8);
+            text(&log," exception-type=");if(name)lc2_menu_trace_string(&log,name);else text(&log,"unresolved");
+        }
+        emit(&log);
+        if(index>=3)trace_frames(ctx);
+    }
+    /* Exact AArch64 prologue replay; same forms as graphics_trace.h. */
+    if((opcode&0xffc003ffU)==0xd10003ffU) {
+        ctx->uc_mcontext.sp-=(opcode>>10)&0xfff;
+    } else if((opcode&0xffc00000U)==0xa9800000U) {
+        int64_t delta=(int64_t)((int32_t)(((opcode>>15)&0x7f)<<25)>>25)*8;
+        unsigned a=opcode&31,b=(opcode>>10)&31;
+        uint64_t sp=ctx->uc_mcontext.sp+delta;
+        if(!accessible(sp,16,PROT_WRITE))stop("LC2_MENU_TRACE_STACK",pc,sp,24);
+        uint64_t pair[2]={a<31?ctx->uc_mcontext.regs[a]:0,b<31?ctx->uc_mcontext.regs[b]:0};
+        memcpy((void *)(uintptr_t)sp,pair,16);ctx->uc_mcontext.sp=sp;
+    } else if((opcode&0xffe00c00U)==0xf8000c00U) {
+        int64_t delta=(int64_t)((int32_t)((opcode>>12)&0x1ff)<<23)>>23;
+        unsigned reg=opcode&31;uint64_t sp=ctx->uc_mcontext.sp+delta;
+        uint64_t value=reg<31?ctx->uc_mcontext.regs[reg]:0;
+        if(!accessible(sp,8,PROT_WRITE))stop("LC2_MENU_TRACE_STACK",pc,sp,24);
+        memcpy((void *)(uintptr_t)sp,&value,8);ctx->uc_mcontext.sp=sp;
+    } else stop("LC2_MENU_TRACE_PROLOGUE",pc,opcode,24);
+    ctx->uc_mcontext.pc+=4;return 1;
+}
+#endif
