diff --git a/native/nvn_fb_present.h b/native/nvn_fb_present.h
new file mode 100644
index 0000000..5e30bde
--- /dev/null
+++ b/native/nvn_fb_present.h
@@ -0,0 +1,120 @@
+#ifndef NVN_FB_PRESENT_H
+#define NVN_FB_PRESENT_H
+/* Presentation straight to the panel.
+ *
+ * Measured on this Mali/fbdev stack: a window surface accepts exactly one eglSwapBuffers and then
+ * refuses every eglMakeCurrent - including on a freshly created surface and after eglReleaseThread()
+ * (build-100..102). Rendering itself is fine on the pbuffer, so the frame is drawn into an offscreen
+ * colour target, read back and copied into the mapped /dev/fb0, flipping pages with FBIOPAN_DISPLAY.
+ * That is the same mechanism the Animal Well trunk used behind AW_FB_COPY, made available here under
+ * COTM_FB_PRESENT=1 and without the eglSwapBuffers call that breaks the surface.
+ */
+struct nvn_fb_present_state {
+    int configured, enabled, fd;
+    unsigned width, height, line, pages, page;
+    uint8_t *map, *pixels;
+    size_t map_len;
+    struct fb_var_screeninfo var;
+    GLuint fbo, texture;
+    uint64_t frames;
+};
+static struct nvn_fb_present_state nvn_fb_present = {.fd = -1};
+
+static unsigned nvn_fb_present_enabled(void) {
+    if (!nvn_fb_present.configured) {
+        const char *option = getenv("COTM_FB_PRESENT");
+        nvn_fb_present.enabled = option && !strcmp(option, "1");
+        nvn_fb_present.configured = 1;
+    }
+    return nvn_fb_present.enabled;
+}
+
+static void nvn_fb_present_open(unsigned width, unsigned height, uint64_t pc) {
+    if (nvn_fb_present.fd >= 0) return;
+    nvn_fb_present.fd = open("/dev/fb0", O_RDWR | O_CLOEXEC);
+    if (nvn_fb_present.fd < 0) stop("NVN_FB_PRESENT_OPEN", pc, errno, 21);
+    struct fb_fix_screeninfo fix;
+    if (ioctl(nvn_fb_present.fd, FBIOGET_FSCREENINFO, &fix) < 0 ||
+        ioctl(nvn_fb_present.fd, FBIOGET_VSCREENINFO, &nvn_fb_present.var) < 0)
+        stop("NVN_FB_PRESENT_INFO", pc, errno, 21);
+    if (nvn_fb_present.var.xres != width || nvn_fb_present.var.yres != height ||
+        nvn_fb_present.var.bits_per_pixel != 32)
+        stop("NVN_FB_PRESENT_FORMAT", pc, nvn_fb_present.var.bits_per_pixel, 21);
+    nvn_fb_present.line = fix.line_length;
+    nvn_fb_present.pages = nvn_fb_present.var.yres_virtual / height;
+    if (!nvn_fb_present.pages) nvn_fb_present.pages = 1;
+    if (nvn_fb_present.pages > 2) nvn_fb_present.pages = 2;
+    nvn_fb_present.map_len = fix.smem_len;
+    nvn_fb_present.map = mmap(NULL, nvn_fb_present.map_len, PROT_READ | PROT_WRITE, MAP_SHARED,
+                              nvn_fb_present.fd, 0);
+    if (nvn_fb_present.map == MAP_FAILED) stop("NVN_FB_PRESENT_MMAP", pc, errno, 21);
+    nvn_fb_present.pixels = malloc((size_t)width * height * 4);
+    if (!nvn_fb_present.pixels) stop("NVN_FB_PRESENT_MEMORY", pc, width * height * 4, 21);
+    nvn_fb_present.width = width;
+    nvn_fb_present.height = height;
+    glGenTextures(1, &nvn_fb_present.texture);
+    glBindTexture(GL_TEXTURE_2D, nvn_fb_present.texture);
+    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, (GLsizei)width, (GLsizei)height, 0, GL_RGBA,
+                 GL_UNSIGNED_BYTE, NULL);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+    glGenFramebuffers(1, &nvn_fb_present.fbo);
+    glBindFramebuffer(GL_FRAMEBUFFER, nvn_fb_present.fbo);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D,
+                           nvn_fb_present.texture, 0);
+    if (glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE)
+        stop("NVN_FB_PRESENT_FBO", pc, 0, 21);
+    struct line b = {0};
+    text(&b, "NVN_FB_PRESENT enabled=1 fb=");
+    hex(&b, width);
+    text(&b, "x");
+    hex(&b, height);
+    text(&b, " line=");
+    hex(&b, nvn_fb_present.line);
+    text(&b, " pages=");
+    hex(&b, nvn_fb_present.pages);
+    text(&b, " swap=none");
+    emit(&b);
+}
+
+static void nvn_fb_present_bind(void) {
+    if (nvn_fb_present.fd < 0) nvn_fb_present_open(nvn_window.fb.width, nvn_window.fb.height, nvn_caller);
+    glBindFramebuffer(GL_FRAMEBUFFER, nvn_fb_present.fbo);
+}
+
+static void nvn_fb_present_swap(void) {
+    unsigned width = nvn_fb_present.width, height = nvn_fb_present.height;
+    /* The panel is BGRA in memory; Mali exposes GL_EXT_read_format_bgra (present in the device's
+     * extension string), so the swizzle happens in the driver and rows are only flipped here. */
+    glReadPixels(0, 0, (GLsizei)width, (GLsizei)height, GL_BGRA_EXT, GL_UNSIGNED_BYTE,
+                 nvn_fb_present.pixels);
+    unsigned page = (nvn_fb_present.page + 1) % nvn_fb_present.pages;
+    uint8_t *dst = nvn_fb_present.map + (size_t)page * height * nvn_fb_present.line;
+    for (unsigned y = 0; y < height; y++) {
+        const uint8_t *src = nvn_fb_present.pixels + (size_t)(height - 1 - y) * width * 4;
+        memcpy(dst + (size_t)y * nvn_fb_present.line, src, (size_t)width * 4);
+    }
+    nvn_fb_present.var.yoffset = page * height;
+    nvn_fb_present.var.xoffset = 0;
+    ioctl(nvn_fb_present.fd, FBIOPAN_DISPLAY, &nvn_fb_present.var);
+    nvn_fb_present.page = page;
+    nvn_fb_present.frames++;
+    /* COTM_FB_PRESENT_FRAMES=<n>: present that many frames and then stop deliberately. The panel path is
+     * the only one that gets past the first swap, so it is also the only way to watch later frames - and a
+     * bounded run cannot leave the device presenting forever. */
+    static int limit_configured;
+    static unsigned limit;
+    if (!limit_configured) {
+        const char *o = getenv("COTM_FB_PRESENT_FRAMES");
+        limit = o ? (unsigned)strtoul(o, NULL, 0) : 0;
+        limit_configured = 1;
+    }
+    if (limit && nvn_fb_present.frames >= limit) {
+        struct line b = {0};
+        text(&b, "NVN_FB_PRESENT_FRAMES_DONE frames=");
+        hex(&b, nvn_fb_present.frames);
+        emit(&b);
+        stop("NVN_FB_PRESENT_FRAMES_DONE", nvn_caller, nvn_fb_present.frames, 24);
+    }
+}
+#endif
