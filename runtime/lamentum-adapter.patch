+ * svcQueryMemory only reports what this table knows, so the title's allocator happily picks an address
+ * inside the host's libc/EGL range and its MapSharedMemory then fails (measured: the platform font at
+ * 0x7f6e204000, SHARED_MAP_FAILED). Register every host mapping below the guest limit as occupied. */
+static void host_mappings_reserve(uint64_t pc) {
+    FILE *f=fopen("/proc/self/maps","r");
+    if(!f)return;
+    char line[512];uint64_t last_end=0;unsigned added=0;
+    while(fgets(line,sizeof line,f)) {
+        uint64_t base=0,end=0;char perms[8]={0};
+        if(sscanf(line,"%llx-%llx %7s",(unsigned long long *)&base,(unsigned long long *)&end,perms)!=3)continue;
+        if(end<=base || base>=AS_END)continue;
+        if(end>AS_END)end=AS_END;
+        base&=~(PAGE-1);end=(end+PAGE-1)&~(PAGE-1);
+        if(last_end && base<last_end)base=last_end;
+        if(end<=base)continue;
+        int covered=0;
+        for(size_t i=0;i<nregions;i++) {
+            struct region r=regions[i];
+            if(base>=r.base && end<=r.base+r.size){covered=1;break;}
+        }
+        if(covered)continue;
+        unsigned perm=0;
+        if(perms[0]=='r')perm|=1;
+        if(perms[1]=='w')perm|=2;
+        if(perms[2]=='x')perm|=4;
+        region_insert((struct region){base,end-base,perm,1,"host_mapping",0},pc);
+        last_end=end;added++;
+    }
+    fclose(f);
