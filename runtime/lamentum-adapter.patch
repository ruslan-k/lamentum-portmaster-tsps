+        if(end>AS_END)end=AS_END;
+        base&=~(PAGE-1);end=(end+PAGE-1)&~(PAGE-1);
+        if(last_end && base<last_end)base=last_end;
+        if(end<=base)continue;
+        int covered=0;
+        for(size_t i=0;i<nregions;i++) {
+            struct region r=regions[i];
+            if(base>=r.base && end<=r.base+r.size){covered=1;break;}
+        }
+        if(covered)continue;
+        unsigned perm=0;
+        if(perms[0]=='r')perm|=1;
+        if(perms[1]=='w')perm|=2;
+        if(perms[2]=='x')perm|=4;
