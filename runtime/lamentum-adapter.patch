+static void nvn_present_checkpoint(const char *step) {
+    static int configured, enabled;
+    if (!configured) {
+        const char *o = getenv("COTM_PRESENT_CHECKPOINTS");
+        enabled = o && !strcmp(o, "1");
+        configured = 1;
+    }
